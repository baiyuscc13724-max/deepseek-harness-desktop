# Optional: semicolon-separated update manifests in priority order (domestic mirror first, GitHub fallback).
HARNESS_DESKTOP_UPDATE_FEEDS=
# Backward-compatible single-feed override.
HARNESS_DESKTOP_UPDATE_FEED=

# Optional developer override for an external dsh command. Production packages use bundled @deepseek-ai/dsh.
HARNESS_DESKTOP_DSH_COMMAND=
HARNESS_DESKTOP_DSH_ARGS=
