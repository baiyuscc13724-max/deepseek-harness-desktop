# Optional: semicolon-separated update manifests in priority order (domestic mirror first, GitHub fallback).
HARNESS_DESKTOP_UPDATE_FEEDS=
# Backward-compatible single-feed override.
HARNESS_DESKTOP_UPDATE_FEED=

# Release-time mirror URL templates. These are public download URLs, not upload credentials.
# The mirror manifest generator tries CNB, then the original GitHub URL.
HARNESS_DESKTOP_CNB_URL_TEMPLATE=
# Or point to an untracked release-mirrors.local.json based on release-mirrors.example.json.
HARNESS_DESKTOP_MIRROR_CONFIG=

# Local CNB publishing credentials belong in the Git-ignored .env.cnb.local file.
CNB_TOKEN_NAME=
CNB_USERNAME=cnb
CNB_TOKEN=
CNB_API_ENDPOINT=https://api.cnb.cool
CNB_REPO_SLUG=

# Optional developer override for an external dsh command. Production packages use bundled @deepseek-ai/dsh.
HARNESS_DESKTOP_DSH_COMMAND=
HARNESS_DESKTOP_DSH_ARGS=
