{
  "name": "deepseek-harness-desktop",
  "version": "1.0.14",
  "private": false,
  "description": "Open-source Windows desktop shell for the official DeepSeek Harness Web UI with automatic local runtime startup, packaged self-test, and release gates.",
  "author": {
    "name": "Harness Desktop Contributors",
    "email": "baiyuscc13724-max@users.noreply.github.com"
  },
  "license": "MIT",
  "type": "commonjs",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "upstream:status": "node scripts/upstream-status.mjs",
    "pack": "electron-builder --dir",
    "dist": "node scripts/build-release.mjs",
    "verify": "node scripts/verify-static.mjs && npm run test:smoke",
    "test:smoke": "node --test tests/*.test.cjs",
    "postinstall": "node scripts/patch-official-runtime.mjs && electron-builder install-app-deps",
    "verify:release": "node scripts/release-audit.mjs",
    "verify:artifact": "node scripts/artifact-audit.mjs dist",
    "verify:packaged": "node scripts/packaged-selftest-contract.mjs",
    "store:assets": "winapp manifest update-assets store/branding/harness-desktop-store.svg --manifest store/Package.appxmanifest.template",
    "store:check": "node scripts/store-readiness.mjs",
    "store:msix": "node scripts/build-store-msix.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.0-rc.6",
    "@deepseek-ai/dsh-atomic-write": "0.1.0-rc.6",
    "@deepseek-ai/dsh-bash-local": "0.1.0-rc.6",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction": "0.1.0-rc.6",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-output-retention": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-telemetry": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-title-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.6",
    "@deepseek-ai/dsh-spill": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.6",
    "@deepseek-ai/dsh-workflow": "0.1.0-rc.6",
    "@earendil-works/pi-ai": "0.82.1",
    "cross-spawn": "7.0.6",
    "dsh-plugin-marketplace": "github:baiyuscc13724-max/DSH-Plugins-Marketplace#41cf453f1267b535258720dda3966b8643f3a224",
    "ws": "^8.21.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@microsoft/winappcli": "^0.5.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.7"
  },
  "build": {
    "appId": "io.harnessdesktop.app",
    "productName": "Harness Desktop",
    "asar": true,
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "!renderer/pet/pet-glb-rig.js",
      "!renderer/pet/pet-rig.js",
      "!renderer/pet/pet-rig-motion.js",
      "!renderer/pet/vendor/**/*",
      "!renderer/pets/maid-whale/model/**/*",
      "!renderer/pets/maid-whale/rig/**/*",
      "!renderer/pets/maid-whale/rive/**/*",
      "!renderer/pets/maid-whale/sprites/keyframes/**/*",
      "!renderer/pets/maid-whale/sprites/inbetweens/**/*",
      "!renderer/pets/maid-whale/sprites/inbetweens-secondary/**/*",
      "build/icon.png",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "docs/**/*",
      "!node_modules/**/*.map",
      "!node_modules/**/*.{ts,tsx,cts,mts}",
      "!node_modules/**/{test,tests,__tests__,example,examples,benchmark,benchmarks}/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "icon": "build/icon.png",
    "npmRebuild": true,
    "asarUnpack": [
      "node_modules/**/*.node"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "Harness-Desktop-${version}-portable-${arch}.${ext}"
    },
    "directories": {
      "output": "dist"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baiyuscc13724-max/deepseek-harness-desktop.git"
  },
  "homepage": "https://github.com/baiyuscc13724-max/deepseek-harness-desktop#readme",
  "bugs": {
    "url": "https://github.com/baiyuscc13724-max/deepseek-harness-desktop/issues"
  }
}
