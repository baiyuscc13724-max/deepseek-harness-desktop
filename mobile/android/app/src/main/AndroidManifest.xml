<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />
    <!-- Retained for the existing in-app QR scanner; composer capture delegates to the system camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="DeepSeek Harness"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.HarnessMobile.Starting"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="harnessmobile" android:host="pair" />
            </intent-filter>
        </activity>
        <activity
            android:name=".HarnessCaptureActivity"
            android:exported="false"
            android:screenOrientation="sensorPortrait"
            android:theme="@style/Theme.HarnessMobile.Scanner" />
        <activity
            android:name=".ControlSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.HarnessMobile" />
        <activity
            android:name=".ScreenCaptureActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.HarnessMobile.Scanner" />
        <activity
            android:name=".DocumentPickerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.HarnessMobile.Scanner" />
        <service
            android:name=".HarnessControlAccessibilityService"
            android:description="@string/control_accessibility_description"
            android:exported="true"
            android:label="DeepSeek Harness 手机控制"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/harness_control_accessibility" />
        </service>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/mobile_update_paths" />
        </provider>
        <provider
            android:name=".MobileInputFileProvider"
            android:authorities="${applicationId}.mobile-inputs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/mobile_file_paths" />
        </provider>
        <service
            android:name=".ControlForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProjection"
            android:stopWithTask="true" />
    </application>
</manifest>
