<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 主题 -->
    <style name="Theme.HarnessMobile" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/harness_primary</item>
        <item name="android:navigationBarColor">@color/harness_surface</item>
        <item name="android:statusBarColor">@color/harness_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/harness_background</item>
    </style>

    <style name="Theme.HarnessMobile.Starting" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/harness_launch_screen</item>
        <item name="android:navigationBarColor">@color/harness_splash_background</item>
        <item name="android:statusBarColor">@color/harness_splash_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.HarnessMobile.Scanner" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <!-- 文字层级：与 iOS 的中文排版习惯对齐 -->
    <style name="TextAppearance.Harness" parent="TextAppearance.AppCompat.Body1" />

    <style name="TextAppearance.Harness.LargeTitle" parent="TextAppearance.AppCompat.Display1">
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/harness_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Harness.Title" parent="TextAppearance.AppCompat.Title">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/harness_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Harness.Headline" parent="TextAppearance.AppCompat.Headline">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/harness_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Harness.Subhead" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/harness_text</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Harness.Body" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/harness_text</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Harness.Callout" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/harness_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Harness.Footnote" parent="TextAppearance.AppCompat.Body2">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/harness_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Harness.Caption" parent="TextAppearance.AppCompat.Body2">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/harness_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Harness.Error" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/harness_error</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Harness.Button" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Harness.Link" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/harness_primary_dark</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- 卡片 -->
    <style name="Widget.Harness.Card" parent="">
        <item name="android:background">@drawable/harness_control_card</item>
        <item name="android:padding">@dimen/harness_card_padding</item>
    </style>

    <!-- 按钮：主操作 -->
    <style name="Widget.Harness.Button.Primary" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">@dimen/harness_touch_min</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Harness.Button</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:backgroundTint">@color/harness_primary</item>
    </style>

    <!-- 按钮：次操作（描边） -->
    <style name="Widget.Harness.Button.Secondary" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">@dimen/harness_touch_min</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Harness.Button</item>
        <item name="android:textColor">@color/harness_primary_dark</item>
        <item name="android:background">@drawable/harness_button_secondary</item>
        <item name="android:backgroundTint">@null</item>
    </style>

    <!-- 按钮：无边框链接 -->
    <style name="Widget.Harness.Button.Link" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:minHeight">@dimen/harness_touch_min</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Harness.Button</item>
        <item name="android:textColor">@color/harness_primary_dark</item>
    </style>

    <!-- 按钮：危险操作 -->
    <style name="Widget.Harness.Button.Destructive" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">@dimen/harness_touch_min</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Harness.Button</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:backgroundTint">@color/harness_error</item>
    </style>

    <!-- 长文本行 -->
    <style name="Widget.Harness.StatusText" parent="">
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
</resources>