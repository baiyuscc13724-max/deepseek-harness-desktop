<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HarnessMobile" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/harness_primary</item>
        <item name="android:navigationBarColor">@color/harness_surface</item>
        <item name="android:statusBarColor">@color/harness_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.HarnessMobile.Starting" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/harness_launch_screen</item>
        <item name="android:navigationBarColor">@color/harness_splash_background</item>
        <item name="android:statusBarColor">@color/harness_splash_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.HarnessMobile.Scanner" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
