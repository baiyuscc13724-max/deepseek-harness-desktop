    <!-- 手机控制设置页 -->
    <string name="back_settings">‹ 返回设置</string>
    <string name="control_title">手机控制</string>
    <string name="control_summary">完成下面的授权后，当前已配对的 Harness 会话才能操作本机。</string>
    <string name="step1_title">1. 开启无障碍服务</string>
    <string name="step1_status">用于读取当前页面的可访问节点，并执行点击、滑动、输入和系统导航。</string>
    <string name="step2_title">2. 屏幕捕获</string>
    <string name="step2_status">不会预先申请。只有 Agent 确实需要看屏幕时，系统才会显示一次捕获授权；每次只截取当前画面并立即停止。</string>
    <string name="step3_title">3. 通知与文件</string>
    <string name="step3_status">前台通知始终提供“立即停止”。文件只通过系统选择器按次授权，不申请整个存储空间。</string>
    <string name="master_switch_text">允许当前已配对会话操作手机</string>
    <string name="stop_now_button">立即停止</string>
    <string name="safety_note">安全边界：密码、支付、银行、验证码、账户安全、清除数据、静默安装/卸载和权限绕过不会自动执行。输入文字、保存文件和清理缓存必须在手机端再次确认。</string>

    <string name="accessibility_on_status">已开启：可以读取当前页面的可访问节点并执行固定手势。</string>
    <string name="accessibility_off_status">未开启：点击下一步，在系统列表中选择“DeepSeek Harness 手机控制”。</string>
    <string name="accessibility_open">打开无障碍设置</string>
    <string name="accessibility_view">查看无障碍设置</string>
    <string name="capture_approved_status">最近一次屏幕捕获由你允许。下一次需要看屏幕时，系统仍会再次询问；图像只在返回任务结果时短暂保留。</string>
    <string name="capture_not_requested_status">尚未申请。只有 Agent 确实需要看屏幕时，系统才会显示捕获授权；每次截取后立即停止。</string>
    <string name="notification_on_status">已允许通知。前台通知会显示当前动作和“立即停止”。文件仍只通过系统选择器按次授权。</string>
    <string name="notification_off_status">通知尚未允许。建议开启，以便在任何页面看到控制状态和“立即停止”。文件不需要整个存储权限。</string>
