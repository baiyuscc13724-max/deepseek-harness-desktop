<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/control_settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/harness_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/harness_screen_padding"
        android:paddingTop="14dp"
        android:paddingEnd="@dimen/harness_screen_padding"
        android:paddingBottom="32dp">

        <Button
            android:id="@+id/control_back"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            style="@style/Widget.Harness.Button.Link"
            android:paddingStart="0dp"
            android:paddingEnd="8dp"
            android:text="@string/back_settings"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            style="@style/TextAppearance.Harness.LargeTitle"
            android:text="@string/control_title" />

        <TextView
            android:id="@+id/control_ready_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            style="@style/TextAppearance.Harness.Callout"
            android:accessibilityLiveRegion="polite"
            android:text="@string/control_summary" />

        <!-- 步骤 1：无障碍服务 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/harness_space_xl"
            android:background="@drawable/harness_control_card"
            android:orientation="vertical"
            android:padding="@dimen/harness_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.Harness.Headline"
                android:text="@string/step1_title" />

            <TextView
                android:id="@+id/accessibility_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                style="@style/TextAppearance.Harness.Footnote"
                android:accessibilityLiveRegion="polite"
                android:text="@string/step1_status" />

            <Button
                android:id="@+id/open_accessibility"
                android:layout_width="match_parent"
                android:layout_height="@dimen/harness_button_height_compact"
                android:layout_marginTop="11dp"
                style="@style/Widget.Harness.Button.Secondary"
                android:text="@string/accessibility_open" />
        </LinearLayout>

        <!-- 步骤 2：屏幕捕获 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/harness_space_md"
            android:background="@drawable/harness_control_card"
            android:orientation="vertical"
            android:padding="@dimen/harness_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.Harness.Headline"
                android:text="@string/step2_title" />

            <TextView
                android:id="@+id/capture_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                style="@style/TextAppearance.Harness.Footnote"
                android:accessibilityLiveRegion="polite"
                android:text="@string/step2_status" />
        </LinearLayout>

        <!-- 步骤 3：通知与文件 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/harness_space_md"
            android:background="@drawable/harness_control_card"
            android:orientation="vertical"
            android:padding="@dimen/harness_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.Harness.Headline"
                android:text="@string/step3_title" />

            <TextView
                android:id="@+id/notification_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                style="@style/TextAppearance.Harness.Footnote"
                android:accessibilityLiveRegion="polite"
                android:text="@string/step3_status" />

            <Button
                android:id="@+id/request_notifications"
                android:layout_width="match_parent"
                android:layout_height="@dimen/harness_button_height_compact"
                android:layout_marginTop="11dp"
                style="@style/Widget.Harness.Button.Secondary"
                android:text="@string/notification_request" />
        </LinearLayout>

        <!-- 总开关与立即停止 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/harness_space_lg"
            android:background="@drawable/harness_control_card"
            android:orientation="vertical"
            android:padding="@dimen/harness_card_padding">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/control_master_switch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:fontFamily="sans-serif-medium"
                android:minHeight="48dp"
                android:text="@string/master_switch_text"
                android:textColor="@color/harness_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/control_live_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                style="@style/TextAppearance.Harness.Footnote"
                android:accessibilityLiveRegion="polite"
                android:text="@string/live_disabled" />

            <Button
                android:id="@+id/control_stop_now"
                android:layout_width="match_parent"
                android:layout_height="@dimen/harness_button_height"
                android:layout_marginTop="13dp"
                style="@style/Widget.Harness.Button.Destructive"
                android:text="@string/stop_now_button" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/harness_space_lg"
            style="@style/TextAppearance.Harness.Caption"
            android:text="@string/safety_note" />
    </LinearLayout>
</ScrollView>